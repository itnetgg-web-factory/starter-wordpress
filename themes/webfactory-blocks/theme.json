{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette": [
        {
          "slug": "base",
          "color": "#FFFFFF",
          "name": "Fond"
        },
        {
          "slug": "surface",
          "color": "#F4F6F8",
          "name": "Fond de section"
        },
        {
          "slug": "contrast",
          "color": "#1B1F24",
          "name": "Texte"
        },
        {
          "slug": "muted",
          "color": "#4B5563",
          "name": "Texte secondaire"
        },
        {
          "slug": "primary",
          "color": "#1D4F91",
          "name": "Principale"
        },
        {
          "slug": "primary-dark",
          "color": "#153A6B",
          "name": "Principale foncée"
        },
        {
          "slug": "accent",
          "color": "#F3C452",
          "name": "Accent"
        },
        {
          "slug": "border",
          "color": "#D3D9E0",
          "name": "Bordure"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "Police système",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Petit",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Normal",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.0625rem"
          }
        },
        {
          "slug": "large",
          "name": "Grand",
          "size": "1.375rem",
          "fluid": {
            "min": "1.2rem",
            "max": "1.375rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Très grand",
          "size": "2rem",
          "fluid": {
            "min": "1.6rem",
            "max": "2rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Titre",
          "size": "2.75rem",
          "fluid": {
            "min": "2rem",
            "max": "2.75rem"
          }
        },
        {
          "slug": "huge",
          "name": "Titre principal",
          "size": "3.5rem",
          "fluid": {
            "min": "2.4rem",
            "max": "3.5rem"
          }
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "Très petit",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "Petit",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "Moyen",
          "size": "clamp(1.25rem, 3vw, 1.5rem)"
        },
        {
          "slug": "50",
          "name": "Grand",
          "size": "clamp(1.5rem, 4vw, 2.5rem)"
        },
        {
          "slug": "60",
          "name": "Très grand",
          "size": "clamp(2.5rem, 6vw, 4rem)"
        },
        {
          "slug": "70",
          "name": "Section",
          "size": "clamp(3rem, 8vw, 6rem)"
        }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "carte",
          "name": "Carte",
          "shadow": "0 2px 12px rgba(27, 31, 36, 0.08)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "currentColor"
        },
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|huge"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|primary-dark"
          }
        }
      },
      "button": {
        "border": {
          "radius": "6px"
        },
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|base"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontWeight": "600",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|primary-dark",
            "text": "var:preset|color|base"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "currentColor",
              "width": "2px"
            },
            "color": {
              "background": "transparent",
              "text": "currentColor"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "500"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var:preset|color|accent",
            "width": "4px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "left": "var:preset|spacing|30"
          },
          "margin": {
            "left": "0",
            "right": "0"
          }
        },
        "elements": {
          "cite": {
            "color": {
              "text": "var:preset|color|muted"
            },
            "typography": {
              "fontSize": "var:preset|font-size|small",
              "fontStyle": "normal"
            }
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|border"
        }
      },
      "core/site-title": {
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "En-tête"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Pied de page"
    }
  ],
  "customTemplates": [
    {
      "name": "page-sans-titre",
      "postTypes": [
        "page"
      ],
      "title": "Page sans titre (accueil, pages composées)"
    }
  ]
}
