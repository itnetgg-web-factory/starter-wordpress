{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "slug": "section-sombre",
  "title": "Section sombre",
  "blockTypes": ["core/group", "core/columns", "core/column"],
  "styles": {
    "color": {
      "background": "var:preset|color|contrast",
      "text": "var:preset|color|base"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|accent" },
        ":hover": { "color": { "text": "var:preset|color|base" } }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|contrast"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|base",
            "text": "var:preset|color|contrast"
          }
        }
      }
    },
    "blocks": {
      "core/quote": {
        "elements": { "cite": { "color": { "text": "var:preset|color|base" } } }
      }
    }
  }
}
