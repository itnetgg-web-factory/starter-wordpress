# Variables attendues par le projet. Ne jamais mettre de vraie valeur secrète dans ce fichier.
# En CI, ces valeurs viennent des secrets GitHub.

# Site
WP_HOME=https://example.com

# Déploiement SSH/SFTP vers l'hébergement (o2switch ou hébergeur du client)
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PATH=/home/<compte>/<site>/wp-content
# La clé SSH de déploiement est un secret GitHub (DEPLOY_SSH_KEY), jamais un fichier du dépôt.
